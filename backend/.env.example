# ======================================================================
# NovaAI backend: copy this file to ".env" and fill in the values.
# Never commit ".env". Lines starting with "#" are optional.
# ======================================================================

# ---- Server ----------------------------------------------------------
# Port to listen on. The frontend expects 5000 by default.
PORT=5000
# Exact address of the web app (used for CORS and for links in emails).
FRONTEND_URL=http://localhost:3000
# "production" on your live server (trust proxy default).
# NODE_ENV=production
# Number of proxies in front of the app. Defaults to 1 in production, off locally.
# Use "false" if the app is exposed directly. Avoid "true" (lets clients fake their IP).
# TRUST_PROXY=1

# ---- Database --------------------------------------------------------
MONGODB_URI=your-mongodb-atlas-connection-string-here

# ---- AI provider (OpenAI-compatible chat API used by /api/chat) ------
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=your-ai-api-key
AI_MODEL=your-default-model-name
# Max chat messages per visitor (IP address) per minute (default 20). Chat has no login,
# so keep this low to protect your AI bill.
# CHAT_RATE_PER_MIN=20

# ---- Email (newsletter confirmation) ---------------------------------
# With no SMTP_HOST the email is printed in the server console instead (development only).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# "true" for port 465; defaults to true only when SMTP_PORT=465
# SMTP_SECURE=false
# EMAIL_FROM="NovaAI <no-reply@yourdomain.com>"
