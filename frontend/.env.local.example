# ======================================================================
# NovaAI frontend: copy this file to ".env.local" and fill in the values.
# Every NEXT_PUBLIC_ value is visible in the browser, so never put secrets here.
# Values are baked in at build time: rebuild after changing them.
# ======================================================================

# Address of the backend API (no trailing slash). Must match the backend's PORT.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public address of this site. Used for the sitemap, robots.txt and social-sharing (OG) image URLs.
# Set it to your real domain in production, e.g. https://novaai.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

